{
  "name": "transparent-image-trimmer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "certs": "office-addin-dev-certs install",
    "build": "vite build",
    "dev": "vite --host localhost --port 3000",
    "check": "npm test && npm run build && npm run validate",
    "test": "node --test tests/*.test.mjs",
    "validate": "office-addin-manifest validate manifest.xml"
  },
  "devDependencies": {
    "office-addin-dev-certs": "^2.0.10",
    "office-addin-manifest": "^2.1.6",
    "vite": "^8.1.5"
  }
}
